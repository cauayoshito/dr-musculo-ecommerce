// Prisma schema para a loja Dr. Músculo

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Definição de usuários – apenas administradores podem acessar o painel
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  hashedPassword String
  role           Role     @default(ADMIN)
  store          Store?   @relation(fields: [storeId], references: [id])
  storeId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]

  @@index([storeId])
}

enum Role {
  ADMIN
  STORE_OWNER
  CUSTOMER
}

// Categorias fixas: suplementos, acessórios, roupas
model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]

  @@index([slug])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  price       Decimal @db.Decimal(10, 2)
  featured    Boolean @default(false)
  bestSeller  Boolean @default(false)
  newArrival  Boolean @default(false)

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  images   Image[]
  variants ProductVariant[]

  // ✅ RELAÇÃO INVERSA (CORRIGE O ERRO)
  orderItems OrderItem[]

  createdAt DateTime @default(now())

  @@index([slug])
}

model Image {
  id        String  @id @default(cuid())
  url       String
  product   Product @relation(fields: [productId], references: [id])
  productId String
}

// Variações de produto (peso, sabor, tamanho, cor etc.)
model ProductVariant {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String
  name      String // nome do atributo (ex.: Tamanho, Sabor)
  option    String // valor da opção (ex.: P, Chocolate)
  price     Decimal @db.Decimal(10, 2)
  stock     Int     @default(0)

  // ✅ RELAÇÃO INVERSA (CORRIGE O ERRO)
  orderItems OrderItem[]
  inventories StoreInventory[]

  @@unique([productId, name, option])
}

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  city      String
  state     String
  isOnline  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories StoreInventory[]
  users       User[]
  orders      Order[]

  @@index([slug])
  @@index([isOnline])
}

model StoreInventory {
  id        String   @id @default(cuid())
  store     Store    @relation(fields: [storeId], references: [id])
  storeId   String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, variantId])
  @@index([storeId])
  @@index([variantId])
}

model Coupon {
  id        String     @id @default(cuid())
  code      String     @unique
  type      CouponType
  value     Decimal    @db.Decimal(10, 2)
  validFrom DateTime?
  validTo   DateTime?
  minOrder  Decimal?   @db.Decimal(10, 2)
  createdAt DateTime   @default(now())

  @@index([code])
}

enum CouponType {
  PERCENTAGE
  VALUE
}

model Order {
  id     String  @id @default(cuid())
  user   User?   @relation(fields: [userId], references: [id])
  userId String?
  store  Store?  @relation(fields: [storeId], references: [id])
  storeId String?

  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String

  status OrderStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  items  OrderItem[]
  total  Decimal     @db.Decimal(10, 2)
  currency String   @default("BRL")
  subtotal Decimal   @db.Decimal(10, 2) @default(0)
  discount Decimal   @db.Decimal(10, 2) @default(0)
  shipping Decimal   @db.Decimal(10, 2) @default(0)
  mpPaymentId String?
  mpPreferenceId String?
  mpMerchantOrderId String?
  mpStatusDetail String?
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([storeId])
}

model OrderItem {
  id String @id @default(cuid())

  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  variantId String?

  quantity Int
  price    Decimal @db.Decimal(10, 2)
  priceAtPurchase Decimal @db.Decimal(10, 2) @default(0)
  productNameSnapshot String @default("")
  variantSnapshot String?
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventId   String   @unique
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}
